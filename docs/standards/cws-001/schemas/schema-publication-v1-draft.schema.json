{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ZenithResearch/castalia-wallet/main/docs/standards/cws-001/schemas/schema-publication-v1-draft.schema.json",
  "title": "Proposed third-party schema publication; no executable adapter or authority grant",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "profileId",
    "profileVersion",
    "publisher",
    "title",
    "parts",
    "operations",
    "requires"
  ],
  "properties": {
    "schema": {
      "const": "castalia.schema-publication.v1-draft"
    },
    "version": {
      "const": 1
    },
    "profileId": {
      "type": "string",
      "minLength": 9,
      "maxLength": 2048,
      "pattern": "^https://[^\\s@?#]+$"
    },
    "profileVersion": {
      "$ref": "https://raw.githubusercontent.com/ZenithResearch/castalia-wallet/main/docs/standards/cws-001/schemas/common.schema.json#/$defs/semver"
    },
    "publisher": {
      "type": "string",
      "minLength": 9,
      "maxLength": 2048,
      "pattern": "^https://[^/?#@\\s]+/?$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "partId",
          "storage",
          "contentClass",
          "valueSchema",
          "requiredForRecovery"
        ],
        "properties": {
          "partId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "storage": {
            "enum": [
              "castaway",
              "recovery",
              "device-local"
            ]
          },
          "contentClass": {
            "enum": [
              "data",
              "authority",
              "session"
            ]
          },
          "valueSchema": {
            "$ref": "https://raw.githubusercontent.com/ZenithResearch/castalia-wallet/main/docs/standards/cws-001/schemas/common.schema.json#/$defs/schemaRef"
          },
          "requiredForRecovery": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "storage": {
                  "const": "castaway"
                }
              }
            },
            "then": {
              "properties": {
                "contentClass": {
                  "const": "data"
                },
                "requiredForRecovery": {
                  "const": false
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "storage": {
                  "const": "recovery"
                }
              }
            },
            "then": {
              "properties": {
                "contentClass": {
                  "const": "authority"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "storage": {
                  "const": "device-local"
                }
              }
            },
            "then": {
              "properties": {
                "contentClass": {
                  "const": "session"
                },
                "requiredForRecovery": {
                  "const": false
                }
              }
            }
          }
        ]
      }
    },
    "operations": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operationId",
          "effect",
          "requestSchema",
          "resultSchema",
          "requiresApproval"
        ],
        "properties": {
          "operationId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{2,127}$"
          },
          "effect": {
            "enum": [
              "read",
              "sign",
              "publish"
            ]
          },
          "requestSchema": {
            "$ref": "https://raw.githubusercontent.com/ZenithResearch/castalia-wallet/main/docs/standards/cws-001/schemas/common.schema.json#/$defs/schemaRef"
          },
          "resultSchema": {
            "$ref": "https://raw.githubusercontent.com/ZenithResearch/castalia-wallet/main/docs/standards/cws-001/schemas/common.schema.json#/$defs/schemaRef"
          },
          "requiresApproval": {
            "const": true
          }
        }
      }
    },
    "requires": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    }
  }
}
