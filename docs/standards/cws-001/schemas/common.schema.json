{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ZenithResearch/castalia-wallet/main/docs/standards/cws-001/schemas/common.schema.json",
  "title": "Shared structural definitions; semantic/cryptographic validation is additional",
  "$defs": {
    "hex32": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "u64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "partId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "httpsId": {
      "type": "string",
      "minLength": 9,
      "maxLength": 2048,
      "pattern": "^https://[^\\s@?#]+$"
    },
    "semver": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][A-Za-z0-9-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][A-Za-z0-9-]*))*)?(\\+[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)*)?$"
    },
    "kdf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "salt",
        "memoryKiB",
        "iterations",
        "parallelism",
        "derivedKeyBytes"
      ],
      "properties": {
        "name": {
          "const": "Argon2id"
        },
        "version": {
          "const": 19
        },
        "salt": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{21}[AQgw]$"
        },
        "memoryKiB": {
          "const": 65536
        },
        "iterations": {
          "const": 3
        },
        "parallelism": {
          "const": 1
        },
        "derivedKeyBytes": {
          "const": 32
        }
      }
    },
    "aead": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "nonce",
        "tagBits"
      ],
      "properties": {
        "name": {
          "const": "AES-256-GCM"
        },
        "nonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{16}$"
        },
        "tagBits": {
          "const": 128
        }
      }
    },
    "ciphertext": {
      "type": "string",
      "minLength": 22,
      "maxLength": 1048576,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "schemaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 9,
          "maxLength": 2048,
          "pattern": "^https://[^\\s@?#]+$"
        },
        "path": {
          "type": "string",
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9_-]+(/[A-Za-z0-9_-]+)*\\.schema\\.json$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "publicationRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 9,
          "maxLength": 2048,
          "pattern": "^https://[^\\s@?#]+$"
        },
        "version": {
          "type": "string",
          "maxLength": 80,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entryId",
        "publication",
        "partId",
        "value"
      ],
      "properties": {
        "entryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "publication": {
          "$ref": "https://raw.githubusercontent.com/ZenithResearch/castalia-wallet/main/docs/standards/cws-001/schemas/common.schema.json#/$defs/publicationRef"
        },
        "partId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "value": {}
      }
    }
  }
}
