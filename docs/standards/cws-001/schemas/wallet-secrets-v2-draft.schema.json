{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ZenithResearch/castalia-wallet/main/docs/standards/cws-001/schemas/wallet-secrets-v2-draft.schema.json",
  "title": "Proposed encrypted recovery plaintext; never data export",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "ownerMemberKey",
    "root",
    "custodyRevision",
    "entries",
    "coverage"
  ],
  "properties": {
    "schema": {
      "const": "castalia.wallet-secrets.v2-draft"
    },
    "version": {
      "const": 2
    },
    "ownerMemberKey": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "root": {
      "$ref": "https://raw.githubusercontent.com/ZenithResearch/castalia-wallet/main/docs/standards/cws-001/schemas/wallet-secret-v1.schema.json"
    },
    "custodyRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "entries": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "https://raw.githubusercontent.com/ZenithResearch/castalia-wallet/main/docs/standards/cws-001/schemas/common.schema.json#/$defs/entry"
      }
    },
    "coverage": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "accountId",
          "source",
          "entryIds",
          "dependencies"
        ],
        "properties": {
          "accountId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "source": {
            "enum": [
              "included",
              "root-derived",
              "external",
              "excluded"
            ]
          },
          "entryIds": {
            "type": "array",
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
          },
          "dependencies": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "derivation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "source": {
                  "const": "included"
                }
              }
            },
            "then": {
              "properties": {
                "entryIds": {
                  "minItems": 1
                },
                "derivation": false,
                "reason": false
              }
            }
          },
          {
            "if": {
              "properties": {
                "source": {
                  "const": "root-derived"
                }
              }
            },
            "then": {
              "required": [
                "derivation"
              ],
              "properties": {
                "entryIds": {
                  "maxItems": 0
                },
                "reason": false
              }
            }
          },
          {
            "if": {
              "properties": {
                "source": {
                  "const": "external"
                }
              }
            },
            "then": {
              "properties": {
                "entryIds": {
                  "maxItems": 0
                },
                "dependencies": {
                  "minItems": 1
                },
                "derivation": false,
                "reason": false
              }
            }
          },
          {
            "if": {
              "properties": {
                "source": {
                  "const": "excluded"
                }
              }
            },
            "then": {
              "required": [
                "reason"
              ],
              "properties": {
                "entryIds": {
                  "maxItems": 0
                },
                "derivation": false
              }
            }
          }
        ]
      }
    }
  }
}
