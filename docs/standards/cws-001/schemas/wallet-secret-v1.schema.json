{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ZenithResearch/castalia-wallet/main/docs/standards/cws-001/schemas/wallet-secret-v1.schema.json",
  "title": "Implemented encrypted custody plaintext; never a public data section",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "keyId",
    "privateKeyPkcs8",
    "createdAt"
  ],
  "properties": {
    "schema": {
      "const": "castalia.wallet-secret.v1"
    },
    "keyId": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "privateKeyPkcs8": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1048576,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "createdAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    }
  }
}
