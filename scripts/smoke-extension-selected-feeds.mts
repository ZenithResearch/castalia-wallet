/** Disposable headless browser qualification, not production enablement. */
import assert from 'node:assert/strict'
import {createServer} from 'node:http'
import {readFile,writeFile,mkdir,mkdtemp,rm,readdir,lstat} from 'node:fs/promises'
import {join,resolve} from 'node:path'
import {createHash} from 'node:crypto'
import {pathToFileURL} from 'node:url'
import {chromium,type BrowserContext,type Page} from 'playwright-core'
import {packageSelectedFeedsFixture} from './package-selected-feeds-fixture.mjs'
import {verifyExtensionPackageDigest} from './extension-package-digest.mjs'
const production=resolve(required('CASTALIA_EXTENSION_DIRECTORY')),evidence=resolve(required('CASTALIA_FEED_EVIDENCE_DIRECTORY')),receiver=resolve(required('BOOKNOOK_FEED_RECEIVER_DIRECTORY'))
function required(name:string){const value=process.env[name];assert.ok(value,`${name} required`);return value}
await mkdir(evidence,{recursive:true});await writeFile(join(evidence,'harness.mts'),await readFile(new URL(import.meta.url)));const temporary=await mkdtemp(join(evidence,'disposable-'))
const fixture=join(evidence,'fixture-package-'+Date.now()),httpRequests:string[]=[],browserRequests:string[]=[],cases:Record<string,unknown>[]=[]
const publicFiles=new Map<string,{bytes:Buffer,type:string}>()
async function inventory(directory:string,prefix=''){for(const entry of await readdir(directory,{withFileTypes:true})){const relative=prefix+entry.name,path=join(directory,entry.name);assert.equal((await lstat(path)).isSymbolicLink(),false);if(entry.isDirectory())await inventory(path,relative+'/');else if(entry.isFile()){const bytes=await readFile(path),type=entry.name.endsWith('.wasm')?'application/wasm':entry.name.endsWith('.html')?'text/html; charset=utf-8':/\.m?js$/.test(entry.name)?'text/javascript; charset=utf-8':'application/octet-stream';publicFiles.set(relative,{bytes,type})}}}
await inventory(receiver)
const probe='<!doctype html><meta charset="utf-8"><title>Synthetic selected feeds receiver</title><button id="request">Request selected settings</button><pre id="result"></pre><script>window.probe={pending:false,result:null,error:null};document.querySelector("#request").onclick=async()=>{window.probe={pending:true,result:null,error:null};try{window.probe.result=await window.castaliaWallet.selectFeeds()}catch(e){window.probe.error=e.message}finally{window.probe.pending=false;document.querySelector("#result").textContent=JSON.stringify(window.probe)}};</script>'
const server=createServer((request,response)=>{const path=new URL(request.url??'/', 'http://localhost').pathname;httpRequests.push(path);response.setHeader('Cache-Control','no-store');if(path==='/probe'){response.setHeader('Content-Type','text/html; charset=utf-8');response.end(probe);return}const key=path==='/receiver'||path==='/receiver/'?'index.html':path.replace(/^\/(?:booknook\/|receiver\/)?/,'');const asset=publicFiles.get(key);if(!asset){response.writeHead(404);response.end();return}response.setHeader('Content-Type',asset.type);response.end(asset.bytes)})
await new Promise<void>((resolve,reject)=>{server.once('error',reject);server.listen(0,'127.0.0.1',()=>resolve())})
const address=server.address();assert.ok(address&&typeof address==='object');const origin='http://127.0.0.1:'+address.port
const before=await verifyExtensionPackageDigest(production,production+'.contents.sha256')
let context:BrowserContext|undefined
const diagnostics:string[]=[],startup:Record<string,unknown>[]=[]
async function launch(extension:string,name:string){const started=Date.now();context=await chromium.launchPersistentContext(join(temporary,name),{headless:true,viewport:null,executablePath:process.env.CASTALIA_CHROMIUM_EXECUTABLE??chromium.executablePath(),ignoreDefaultArgs:['--disable-extensions'],args:['--disable-features=DisableLoadExtensionCommandLineSwitch',`--disable-extensions-except=${extension}`,`--load-extension=${extension}`]});context.on('request',request=>browserRequests.push(request.url()));context.on('console',message=>diagnostics.push(message.type()+': '+message.text()));context.on('page',p=>{p.on('pageerror',e=>diagnostics.push(e.message));p.on('console',m=>{if(m.type()==='error')diagnostics.push(m.text())})});const launched=Date.now();const worker=context.serviceWorkers()[0]??await context.waitForEvent('serviceworker',{timeout:15000});console.log(name+' worker ready: '+worker.url());console.log(name+' worker listeners: '+JSON.stringify(await worker.evaluate(()=>({messages:(globalThis as any).chrome.runtime.onMessage.hasListeners(),connections:(globalThis as any).chrome.runtime.onConnect.hasListeners()}))));startup.push({name,launchMilliseconds:launched-started,workerReadyMilliseconds:Date.now()-started});return context}
async function page(path='/probe'){assert.ok(context);const p=await context.newPage();await p.goto(origin+path);await p.waitForFunction(()=>typeof (window as any).castaliaWallet?.selectFeeds==='function');return p}
async function requested(p:Page){await p.locator('#request').click()}
async function probeResult(p:Page){await p.waitForFunction(()=>!(window as any).probe.pending);return p.evaluate(()=>(window as any).probe)}
async function popup(path:string,action:()=>Promise<unknown>){assert.ok(context);const pending=context.waitForEvent('page',{timeout:15000});await action();const p=await pending;await p.waitForURL('**/'+path+'?*');await p.waitForLoadState('domcontentloaded');return p}
const vectors=JSON.parse(await readFile(new URL('../contracts/feeds/v1/projection-conformance.json',import.meta.url),'utf8')),choice=JSON.parse(vectors.cases[0].selectionRaw)
async function choose(p:Page,empty=false){
 await p.locator('#continue:not([disabled])').waitFor();assert.equal(await p.locator('input:checked').count(),0);assert.equal(await p.locator('.source-choice:disabled').count(),1);assert.equal(await p.getByRole('checkbox',{name:'Untitled source',exact:true}).count(),1);assert.equal(await p.getByRole('checkbox',{name:/^Unnamed collection \(/}).count(),1)
 async function checkKey(selector:string,key:string){const inputs=p.locator(selector),keys=await inputs.evaluateAll(nodes=>nodes.map(n=>(n as HTMLInputElement).dataset.key));const index=keys.indexOf(key);assert.ok(index>=0);await inputs.nth(index).check()}
 if(!empty){for(const id of choice.subscriptionIds)await checkKey('.source-choice',id);for(const id of choice.collectionIds)await checkKey('.label-choice',id);for(const member of choice.memberships)for(const id of member.collectionIds)await checkKey('.membership-choice',JSON.stringify([member.subscriptionId,id]))}
}

try{
  await launch(production,'production-profile');const negative=await page();const caps=await negative.evaluate(()=>(window as any).castaliaWallet.getCapabilities());assert.equal(caps.includes('selected_feeds_v1'),false);await requested(negative);assert.equal((await probeResult(negative)).error,'feed_projection_unsupported');assert.equal(context!.pages().some(p=>p.url().includes('selected-feeds-choice')),false);cases.push({case:'untouched-production-default-refusal',passed:true});await context!.close();context=undefined
  await packageSelectedFeedsFixture(production,fixture,origin)
  await launch(fixture,'synthetic-profile');const worker=context!.serviceWorkers()[0]??await context!.waitForEvent('serviceworker'),id=new URL(worker.url()).host,setup=await context!.newPage();await setup.goto(`chrome-extension://${id}/fixture-setup.html`)
  async function control(action:string){await setup.locator('#'+action).click();await setup.waitForFunction(()=>{const value=document.querySelector('#status')?.textContent;return value?.startsWith('{')});const value=JSON.parse(await setup.locator('#status').innerText());assert.equal(value.ok,true,JSON.stringify(value));return value.result}
  await control('setup');const unapproved=await page();await requested(unapproved);assert.equal((await probeResult(unapproved)).error,'origin_not_approved');await control('approve');await control('guards');cases.push({case:'actual-synthetic-custody-unlock-separate-origin-approval-v3-guard',passed:true})
  const target=await page('/receiver');await target.evaluate(()=>(window as any).feedReceiverTest.ready);
  async function noEarlyDisclosure(){const state=await target.evaluate(async()=>({state:(window as any).feedReceiverTest.state,row:await (window as any).feedReceiverTest.read()}));assert.equal(state.state.raw,null);assert.equal(state.state.pending,false);assert.deepEqual(state.row.config.feeds.subscriptions,[])}
  const chooser=await popup('selected-feeds-choice.html',()=>target.locator('#request-feeds').click());await choose(chooser);await chooser.screenshot({path:join(evidence,'choices.png'),fullPage:true});
  await noEarlyDisclosure();const review=await popup('selected-feeds-confirmation.html',()=>chooser.locator('#continue').click());await review.locator('#approve:not([disabled])').waitFor();assert.equal(await review.locator('#origin').innerText(),origin);assert.equal((await review.locator('#selected').innerText()).includes('Private source'),false);await review.screenshot({path:join(evidence,'consent.png'),fullPage:true});await noEarlyDisclosure();await review.locator('#approve').click();
  // Delivery is not host import consent. Exercise the separate visible action.
  await target.waitForFunction(()=>typeof (window as any).feedReceiverTest?.state.raw==='string');
  const beforeImport=await target.evaluate(async()=>({state:(window as any).feedReceiverTest.state,row:await (window as any).feedReceiverTest.read()}));
  assert.equal(beforeImport.state.error,null);assert.deepEqual(JSON.parse(beforeImport.state.raw),vectors.cases[0].expectedSection);assert.equal(beforeImport.state.pending,true);assert.deepEqual(beforeImport.row.config.feeds.subscriptions,[]);assert.deepEqual(beforeImport.state.activations,[]);assert.equal(beforeImport.state.providerInstalled,false);
  await target.locator('#confirm-import:not([disabled])').click();await target.waitForFunction(()=>(window as any).feedReceiverTest.state.result?.changed===true&&!(window as any).feedReceiverTest.state.pending);
  const afterImport=await target.evaluate(async()=>({state:(window as any).feedReceiverTest.state,row:await (window as any).feedReceiverTest.read()}));assert.deepEqual(afterImport.row.config.feeds,vectors.cases[0].expectedSection);assert.deepEqual(afterImport.state.activations,[]);assert.equal(afterImport.state.providerInstalled,false);cases.push({case:'actual-browser-delivery-and-explicit-inert-booknook-import',passed:true});await target.screenshot({path:join(evidence,'receiver.png'),fullPage:true});
  const receiverAssertions=process.env.BOOKNOOK_FEED_RECEIVER_ASSERTIONS;
  if(receiverAssertions){const {runFeedReceiverAssertions}=await import(pathToFileURL(resolve(receiverAssertions)).href);const result=await runFeedReceiverAssertions(context,origin+'/receiver');assert.equal(result.fixtureOnly,true);assert.equal(result.runtimeOrProductionAcceptance,false);assert.equal(result.passed.length,10);cases.push({case:'receiving-host-independent-SDK-and-IndexedDB',...result})}
  const p=await page();let c=await popup('selected-feeds-choice.html',()=>requested(p));await choose(c,true);let r=await popup('selected-feeds-confirmation.html',()=>c.locator('#continue').click());await r.locator('#approve:not([disabled])').waitFor();await r.locator('#approve').click();assert.deepEqual(JSON.parse((await probeResult(p)).result).subscriptions,[]);cases.push({case:'empty-explicit-consent',passed:true})
  c=await popup('selected-feeds-choice.html',()=>requested(p));await c.locator('#cancel:not([disabled])').click();assert.equal((await probeResult(p)).result,null);cases.push({case:'choice-cancel',passed:true})
  c=await popup('selected-feeds-choice.html',()=>requested(p));await choose(c);r=await popup('selected-feeds-confirmation.html',()=>c.locator('#continue').click());await r.locator('#deny:not([disabled])').click();assert.equal((await probeResult(p)).result,null);cases.push({case:'consent-deny',passed:true})
  c=await popup('selected-feeds-choice.html',()=>requested(p));await control('reseal');await choose(c);r=await popup('selected-feeds-confirmation.html',()=>c.locator('#continue').click());await r.locator('#approve:not([disabled])').click();assert.equal((await probeResult(p)).result,null);cases.push({case:'exact-ciphertext-staleness',passed:true})
  c=await popup('selected-feeds-choice.html',()=>requested(p));await control('advance90');await choose(c);r=await popup('selected-feeds-confirmation.html',()=>c.locator('#continue').click());await r.locator('#approve:not([disabled])').waitFor();await control('advance31');await r.locator('#approve').click();assert.equal((await probeResult(p)).result,null);await control('reset-clock');cases.push({case:'combined120s-deadline-synthetic-clock',passed:true})
  c=await popup('selected-feeds-choice.html',()=>requested(p));await control('lock');assert.equal((await probeResult(p)).result,null);await control('unlock');cases.push({case:'real-custody-lock-cancellation',passed:true})
  c=await popup('selected-feeds-choice.html',()=>requested(p));const closed=c.waitForEvent('close');await p.goto(origin+'/probe?replacement=1');await closed;cases.push({case:'document-navigation-cancellation',passed:true})
  const network=browserRequests.filter(url=>/^https?:/.test(url)&&new URL(url).origin!==origin);assert.deepEqual(network,[])
  const after=await verifyExtensionPackageDigest(production,production+'.contents.sha256');assert.equal(after.digest,before.digest)
  const fixtureDigest=await verifyExtensionPackageDigest(fixture,fixture+'.contents.sha256')
  await writeFile(join(evidence,'browser-receipt.json'),JSON.stringify({schema:'castalia.selected-feeds-browser-acceptance.v1',synthetic:true,headless:true,productionEnabled:false,personalProfilesUsed:false,browserVersion:context!.browser()!.version(),startup,harnessSha256:createHash('sha256').update(await readFile(new URL(import.meta.url))).digest('hex'),receiverAssertions:receiverAssertions?{path:resolve(receiverAssertions),sha256:createHash('sha256').update(await readFile(resolve(receiverAssertions))).digest('hex')}:null,productionDigest:before.digest,fixturePath:fixture,fixtureDigest:fixtureDigest.digest,cases,externalHTTPRequestsObservedByContext:network,httpRequests,receiverArtifacts:[...publicFiles].map(([path,file])=>({path,bytes:file.bytes.length,sha256:createHash('sha256').update(file.bytes).digest('hex')}))},null,2)+'\n')
  console.log(JSON.stringify({passed:true,cases:cases.length,productionEnabled:false,receipt:join(evidence,'browser-receipt.json')}))
}catch(error){await writeFile(join(evidence,'failure.json'),JSON.stringify({error:String(error),pages:context?.pages().map(p=>p.url()),diagnostics,httpRequests,cases},null,2)+'\n');throw error}finally{await context?.close();await new Promise<void>(resolve=>server.close(()=>resolve()));await rm(temporary,{recursive:true,force:true})}
